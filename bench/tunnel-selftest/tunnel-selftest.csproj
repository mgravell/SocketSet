<Project Sdk="Microsoft.NET.Sdk">

  <!-- Was a file-based app; promoted to a real project when the transport retargeted onto the sibling
       StackExchange.Redis checkout — `dotnet run -\-file` leaks its #:property TFM overrides as global
       properties into the cross-repo restore graph, which poisons that repo's eng/ build-task project
       (NETSDK1005). A real csproj restores the graph the same way the library build does. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- SER009: the transport contract is [Experimental] by design and this rig is its gate.
         StringToRedisValue: upstream made the implicit string->RedisValue conversion experimental after
         this rig was written; the rig's string keys/values are test fixtures, not an opinion on it. -->
    <NoWarn>$(NoWarn);SER009;StringToRedisValue</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SocketSet.StackExchange.Redis/SocketSet.StackExchange.Redis.csproj" />
  </ItemGroup>

  <!-- Same OS-picks-its-own-backends helper the security gates use: this rig stopped being Linux-only
       when TLS became the transport's job, and the Windows half is the half nothing was gating. -->
  <ItemGroup><Compile Include="../GateBackends.cs" /></ItemGroup>

</Project>
