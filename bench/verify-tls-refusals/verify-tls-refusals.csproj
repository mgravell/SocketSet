<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net11.0: the tls-session provider only exists there, and it is half of what this verifies.
         PLURAL on purpose: Directory.Build.props sets TargetFrameworks for the repo, and only the
         plural property here overrides it (a singular TargetFramework loses, and you get net10+net472). -->
    <TargetFrameworks>net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SocketSet\SocketSet.csproj" />
  </ItemGroup>
</Project>
