<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SocketSets.AspNet</RootNamespace>
    <!-- RESPITE001: the vendored CycleBuffer is [Experimental]; the half-pipe opts in (see HalfPipeWriter). -->
    <NoWarn>$(NoWarn);RESPITE001</NoWarn>

    <!-- Package metadata for external consumers. -->
    <IsPackable>true</IsPackable>
    <PackageId>SocketSet.AspNetCore</PackageId>
    <Description>A Kestrel connection transport backed by SocketSet (io_uring / epoll / IOCP / RIO / managed), with optional transport-terminated TLS (OpenSSL/SChannel, plus kTLS on Linux). Add it with builder.WebHost.UseSocketSet(...).</Description>
    <Authors>Marc Gravell</Authors>
    <PackageTags>kestrel;transport;io_uring;epoll;iocp;rio;tls;ktls;sockets;aspnetcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SocketSet/SocketSet.csproj" />
    <!-- Vendored, not a package dependency: PrivateAssets removes it from the nuspec, and the
         target below folds the DLL into lib/ so the package is self-contained. -->
    <ProjectReference Include="../../vendor/RESPite.Vendored.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackVendoredAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="PackVendoredAssemblies">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)RESPite.Vendored.dll" />
    </ItemGroup>
  </Target>

</Project>
