<Project>

    <!-- Language / compilation defaults for every project in the repo. -->
    <PropertyGroup>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
    </PropertyGroup>

    <!-- Package/assembly identity. Only the library opts in to packing (see its .csproj). -->
    <PropertyGroup>
        <Authors>Marc Gravell</Authors>
        <Company>Marc Gravell</Company>
        <Product>SocketSet</Product>
        <Copyright>Copyright (c) 2026 Marc Gravell</Copyright>
        <RepositoryUrl>https://github.com/mgravell/SocketSet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- assets/logo/ring.svg is the source; assets/icon.png is it rasterized to the 128px NuGet wants. -->
        <PackageIcon>icon.png</PackageIcon>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
      Versioning comes from version.json + git height (Nerdbank.GitVersioning): the series is pinned
      to 0.1 there, the patch is the number of commits since that pin, and builds off main carry a
      -g<commit> suffix so only main produces release versions. AssemblyVersion is pinned outright to
      0.1.0.0 — with a strong name in play, moving it every commit would break binding for every
      consumer; FileVersion and the package version still move with git height.
    -->
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.91" PrivateAssets="all" />
    </ItemGroup>

    <!--
      Strong-name everything from one repo key. Retro-fitting a strong name is a breaking change for
      every consumer, and .NET Framework consumers (GAC, binding redirects, strong-name-signed callers)
      can't reference an unsigned assembly at all — so it has to be on from the first build. The key is
      committed on purpose: a strong name is an identity, not a secret, and full signing means no
      consumer needs a key of their own.
    -->
    <PropertyGroup>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)SocketSet.snk</AssemblyOriginatorKeyFile>
        <DelaySign>false</DelaySign>
        <PublicSign>false</PublicSign>
    </PropertyGroup>

    <!-- Symbols + deterministic, source-linked builds. SourceLink for GitHub ships in the SDK. -->
    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <!--
          Release implies CI-build semantics so that *anyone* can reproduce a shipped package with a
          plain `dotnet build -c Release` — reproducibility is a property of the artifact, not of the
          environment it happened to be built in. The cost is that source paths in a locally-built
          Release binary are normalized, so stepping into one goes via SourceLink rather than the
          working copy; Debug, where that actually matters, is unaffected.
        -->
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--
      Repeatable restore: packages.lock.json pins the *transitive* graph, not just the versions written
      in the project files, so a restore months from now resolves exactly what it resolves today. The
      lock files are committed; CI restores in locked mode, where any drift from them is an error rather
      than a silent update. Locally the lock file is allowed to update itself, so adding a
      PackageReference just works — commit the resulting lock file change with it.
    -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>

    <!--
      Build net472 from the NuGet reference assemblies rather than whatever targeting packs happen to be
      installed on the machine — same inputs on a dev box, a CI agent, or a non-Windows host.
    -->
    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

</Project>
