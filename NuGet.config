<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore must not depend on whatever feeds happen to be configured on the machine: <clear /> drops
  any inherited sources (user-level, CI agent, VS) so nuget.org is the only place packages can come
  from, and the source mapping makes that explicit rather than incidental.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
