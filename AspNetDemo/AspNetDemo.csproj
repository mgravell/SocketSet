<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Plural, to override the repo-wide net10.0;net472 in Directory.Build.props: ASP.NET Core is
         net10.0-only, and multi-targeting here also makes a bare `dotnet run` ambiguous. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SocketSets.AspNet</RootNamespace>
    <!-- RESPITE001: the vendored CycleBuffer is marked [Experimental]; we opt in (see HalfPipeWriter). -->
    <NoWarn>$(NoWarn);RESPITE001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/SocketSet/SocketSet.csproj" />
    <ProjectReference Include="../vendor/RESPite.Vendored.csproj" />
  </ItemGroup>

</Project>
