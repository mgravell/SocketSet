<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Plural, to override the repo-wide net10.0;net472 in Directory.Build.props: ASP.NET Core is
         net10.0-only, and multi-targeting here also makes a bare `dotnet run` ambiguous. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SocketSets.AspNet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The transport implementation now lives in the library; the demo only maps flags onto its options.
         SocketSet core is referenced directly too, because DemoConfig names its types (backend factory,
         TLS providers). -->
    <ProjectReference Include="../src/SocketSet.AspNetCore/SocketSet.AspNetCore.csproj" />
    <ProjectReference Include="../src/SocketSet/SocketSet.csproj" />
  </ItemGroup>

</Project>
